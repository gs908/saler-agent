# WeCom Bot Configuration
WECOM_BOT_ID=your-bot-id
WECOM_BOT_SECRET=your-bot-secret

# Optional: WebSocket Server URL (default: wss://openws.work.weixin.qq.com)
# WECOM_WS_URL=wss://openws.work.weixin.qq.com

# Optional: Heartbeat interval in milliseconds (default: 30000)
# WECOM_HEARTBEAT_INTERVAL=30000

# Optional: Max reconnection attempts (default: 10)
# WECOM_MAX_RECONNECT_ATTEMPTS=10

# Optional: Log level (default: info)
# WECOM_LOG_LEVEL=info

# 可选：图片/文件/视频回调里若只有 url、没有 aeskey 时，填「智能机器人 - 回调加解密」的 EncodingAESKey（与文档结构体说明一致）
# WECOM_RESOURCE_AESKEY=

# Internal API - HTTP endpoints for external services to send messages
# Format: JSON array of {appId, secret} objects
# Example: [{"appId": "workflow-node-1", "secret": "secret-xxx"}, {"appId": "workflow-node-2", "secret": "secret-yyy"}]
# INTERNAL_API_TOKENS=[{"appId": "my-app", "secret": "your-secret"}]

# API Server Port (default: 3840)
# API_PORT=3840


